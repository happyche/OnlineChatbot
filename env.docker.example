# Docker 部署用环境变量示例
# 用法: copy env.docker.example .env  （Windows）
#       cp env.docker.example .env    （Linux/macOS）
# 然后编辑 .env，至少填入 LLM_API_KEY（若使用云端模型）

# === 宿主机端口映射（docker-compose 用）===
PORT=8000

# === 构建镜像时下载模型（可选）===
# HF_ENDPOINT=https://hf-mirror.com
# HF_TOKEN=

# === 对话模型 ===
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 若 LLM 跑在宿主机 Ollama，可改为:
# LLM_PROVIDER=local
# LOCAL_LLM_BASE_URL=http://host.docker.internal:11434/v1
# LOCAL_LLM_MODEL=qwen2.5:7b

# === 嵌入 / 重排（镜像内已预置 ONNX 权重，一般无需改）===
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
EMBEDDING_CACHE_DIR=/app/models
RERANK_ENABLED=true
RERANK_PROVIDER=local
RERANK_MODEL=BAAI/bge-reranker-base
HYBRID_SEARCH_ENABLED=true

# === 持久化路径（容器内固定，与 compose volume 对应）===
UPLOADS_DIR=/data/uploads
SETTINGS_FILE=/data/settings.json

# === 向量库（Qdrant）===
# docker-compose 会同时起一个 qdrant 服务，应用经 QDRANT_URL 连接，一般无需改。
# 给 qdrant 服务开了鉴权（QDRANT__SERVICE__API_KEY）时，在这里填同一个 key
# QDRANT_API_KEY=
# 宿主机上 Qdrant 控制台的端口（只绑 127.0.0.1）
# QDRANT_PORT=6333
# 多套环境共用一个 Qdrant 时用不同的集合名隔开
# QDRANT_COLLECTION=documents

# === 安全（生产建议开启）===
# APP_API_TOKEN=change-me
# CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# === 可观测性与在线反馈 ===
# 路径类配置由 docker-compose.yml 固定指向挂载卷（/data），这里只放开关与单价。
# 反馈库和请求日志都在 /data 上，容器重建不丢。
FEEDBACK_ENABLED=true
METRICS_ENABLED=true
# 走云端模型时填真实单价（每千 token），否则成本一律报 0
# LLM_PRICING={"qwen-plus":{"prompt":0.0008,"completion":0.002}}
COST_CURRENCY=CNY
# 端点若对 stream_options 返回 400，置为 false（token 数改用估算值）
LLM_STREAM_USAGE=true

# 抓取指标（APP_API_TOKEN 设了之后要带同一个头）：
#   curl -H "X-API-Token: change-me" http://localhost:8000/metrics
# 导出线上差评为回归题集：
#   docker compose exec chatbot python scripts/badcase_export.py --summary
