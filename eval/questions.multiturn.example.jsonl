# 多轮追问示例问题集，对应 eval/corpus.example/运维手册.md
# 每行除常规字段外增加 history：模拟前端 chatHistory 传入的后端上下文。
# 评测时用 question + history 调 retrieve_with_diagnostics，对比 rewrite 开/关的 Hit@K / MRR。
{"question": "它的默认值呢？", "history": [{"role": "user", "content": "REQUEST_TIMEOUT 默认多少秒？"}, {"role": "assistant", "content": "默认 60 秒；若经常超时应先排查网络链路。"}], "ground_truth": "REQUEST_TIMEOUT 默认 60 秒。", "expected_keywords": ["REQUEST_TIMEOUT", "60"], "expected_sources": ["运维手册.md"], "type": "multiturn-followup"}
