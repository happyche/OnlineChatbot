eval/corpus/
# 与内部语料绑定的问题集；公开仓库用 questions.example.jsonl
eval/questions.hss.jsonl
# 跑出来的结果，可重复生成
eval/sweep_*.jsonl
eval/ragas_*.jsonl
eval/ragas_*report.md
eval/samples*.jsonl
eval/scored_*.jsonl
eval/*_results.jsonl
eval/sweep_results.jsonl

