# ---- 本地设计笔记 / 内部变更记录（不上传公开仓库）----
DESIGN.md
DOCKER_DEPLOY_CHANGELOG.md

# ---- 打包产物 ----
*.tar
onlinechatbot.tar

# ---- 密钥与本地配置（切勿提交）----
.env
.env.*
!.env.example
# settings.json 保存 UI 修改后的配置，其中含 API Key 明文
settings.json

# ---- 运行时数据 ----
chroma_db/
uploads/
*.log
# 反馈库：含提问、答案与文档原文，和 .env 同一类东西，绝不能进仓库
data/
# 日志目录整体排除：app.log 之外还有脚本的 stdout/stderr 留痕，
# 它们同样会带上提问正文，逐个模式列举早晚会漏一个
logs/
# Hugging Face / fastembed 下载中断留下的分片
*.incomplete

# ---- 评测：本地专用数据与运行产物 ----
# 内部/受限语料（如 Nokia HSS 手册转换稿）
eval/corpus/
# 与内部语料绑定的问题集；公开仓库用 questions.example.jsonl
eval/questions.hss.jsonl
# 跑出来的结果，可重复生成
eval/sweep_*.jsonl
eval/ragas_*.jsonl
eval/ragas_*report.md
eval/samples*.jsonl
eval/scored_*.jsonl
eval/*_results.jsonl
eval/sweep_results.jsonl
# 从线上差评导出的题集：含真实提问，且是可重复生成的产物
eval/questions.badcase.jsonl
eval/questions.regression.jsonl
# agent 评测的跑分结果，跟 sweep_results 同类：可重复生成，不进仓库
eval/agent-*.json

# ---- Python ----
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
Thumbs.db
