# === 对话模型配置 ===
# openai = 云端 API（需要 API Key，按量计费）
# local  = 自建的 OpenAI 兼容服务（Ollama / vLLM / LM Studio / llama.cpp），
#          可以在本机，也可以在内网服务器上
LLM_PROVIDER=openai

# --- LLM_PROVIDER=openai 时生效 ---
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# --- LLM_PROVIDER=local 时生效 ---
# 必须是 OpenAI 兼容地址，通常以 /v1 结尾。填服务器实际 IP 或主机名。
# 常见默认端口：Ollama 11434 ｜ vLLM 8000 ｜ LM Studio 1234 ｜ llama.cpp 8080
#
# Ollama 提示：默认只监听 127.0.0.1，从别的机器连不上。需要在服务器上设置
# OLLAMA_HOST=0.0.0.0:11434 后重启，并放行防火墙端口。
# 模型名必须带 tag（qwen2.5:7b 而非 qwen2.5），用 ollama list 查看。
LOCAL_LLM_BASE_URL=http://192.168.1.10:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
# 多数自建服务不校验；vLLM 若启用了 --api-key 则填写
LOCAL_LLM_API_KEY=
# 本地模型首字延迟通常更长，必要时调大下方的 REQUEST_TIMEOUT

# === 嵌入配置 ===
# local  = 本地 ONNX 推理（默认）：离线、免费、文本不出本机
# openai = 远程接口：省本地资源，但文本会离开本机且按量计费
# hashing = 确定性哈希，仅供测试
EMBEDDING_PROVIDER=local

# --- provider=local 时生效 ---
# bge-small-zh-v1.5：约 90MB、512 维、中文检索质量足够，输出已 L2 归一化
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型权重缓存目录，留空则用 ~/.cache/fastembed。
# 不要放系统临时目录，会被清理后触发重新下载。
EMBEDDING_CACHE_DIR=
# 部分模型要求查询与文档使用不同的指令前缀（如 e5 系列的 "query: " / "passage: "）。
# bge-*-v1.5 不需要，留空即可。
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=

# --- provider=openai 时生效 ---
EMBEDDING_MODEL=text-embedding-v3
# 嵌入接口的独立地址；留空则复用当前生效的对话端点。
# 注意：DashScope 的 coding 专用端点（coding.dashscope.aliyuncs.com）只提供
# chat，不提供 /embeddings。若 LLM_BASE_URL 指向该端点，这里必须填标准端点。
EMBEDDING_BASE_URL=
# 嵌入接口的独立 Key；留空则复用对话端点的 Key。
# 对话走内网自建（无需 Key）而嵌入走云端（需要 Key）时必须单独配置。
EMBEDDING_API_KEY=
# 单次嵌入请求的文本条数上限
EMBEDDING_BATCH_SIZE=10

# === RAG 配置 ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
TEMPERATURE=0.2
# 余弦相似度低于该值的检索结果被丢弃，避免无关内容污染上下文。
# 只作用于向量这一路：BM25 命中的片段不受此阈值限制。
MIN_SIMILARITY=0.2

# === 检索增强（两个开关可独立开闭，便于做消融对比）===
# 混合检索：向量检索之外并行跑 BM25，用 RRF 融合两路排名。
# 向量检索靠语义，对精确串（kubectl exec、错误码、配置项名）较弱，BM25 互补。
HYBRID_SEARCH_ENABLED=false
# BM25 分词器：jieba=词粒度｜bigram=字符二元组（不受词典覆盖率影响）
BM25_TOKENIZER=jieba
# RRF 平滑常数，越大则头部名次优势越小；60 为原论文取值
RRF_K=60

# 交叉编码器重排：对候选精排，精度更高但耗时明显增加
RERANK_ENABLED=false
# local=本地 ONNX 交叉编码器｜lexical=字面重叠度（仅冒烟用）
RERANK_PROVIDER=local
# bge-reranker-base 约 1GB、支持中文
# 预下载： python scripts/download_model.py --reranker
RERANK_MODEL=BAAI/bge-reranker-base
# 重排分数下限，留空表示不过滤。交叉编码器输出未归一化，需实测后再定。
MIN_RERANK_SCORE=

# 开启融合或重排时每路先取的候选数，融合/精排后再截到 TOP_K。
# 太小会让重排无从改进排序。
CANDIDATE_POOL_SIZE=20
# 送入模型的历史消息条数上限（2 条为一轮）
HISTORY_LIMIT=10
REQUEST_TIMEOUT=60
# 访问内网/本机地址时绕过 HTTP_PROXY。企业环境普遍配了代理，而客户端默认
# 读取该环境变量，会导致内网自建服务的请求被发去代理并返回 HTML 错误页。
BYPASS_PROXY_FOR_INTERNAL=true

# 送入 LLM 的历史消息条数上限（2 条 = 1 轮问答）
HISTORY_LIMIT=10

# === 多轮 Query Rewrite（检索前改写；生成仍用原问题 + 历史）===
# 默认开启；首问或无指代时不额外调 LLM
QUERY_REWRITE_ENABLED=true
# conditional=启发式触发 | always=有 history 就改写 | off=关闭
QUERY_REWRITE_MODE=conditional
# 改写 prompt 使用的历史条数（默认 6 条 ≈ 3 轮）
REWRITE_HISTORY_LIMIT=6
# 条件触发：问句不超过该字数时视为可能省略
REWRITE_TRIGGER_MAX_LEN=12
# 逗号分隔正则；留空用内置指代词表
# REWRITE_TRIGGER_PATTERNS=它,这个,刚才
# 留空复用对话模型；可指定更小模型降延迟
# REWRITE_MODEL=
REWRITE_TEMPERATURE=0

# === Agent 层（可选，需 pip install -r requirements-agent.txt）===
# 打开后 /api/chat 改走 langchain 的 create_agent：模型自己决定用哪个工具、
# 调几次，然后基于取回的资料作答。默认关闭：每问多 1~3 次 LLM 调用，
# 该不该开应由评测数据决定（与两个检索增强开关同理）。
AGENT_ENABLED=false
# 终止条件之一：模型调用次数上限。达到后带着现有材料直接作答，不报错。
# 一次取材 = 一次调用（决定调工具）+ 一次（读结果），所以 6 约等于两轮取材
AGENT_MAX_MODEL_CALLS=6
# 终止条件之二：图层面的兜底。与调用次数上限管的不是同一类失效，但必须比它宽：
# 兜底是报错中止，先触发的话用户拿到的是报错而不是答案。
# 32 是配 MAX_MODEL_CALLS=6 算的（一次模型调用在图上占 5 步，收尾再加 2），
# 调大上面那个值时这里要一起调大
AGENT_RECURSION_LIMIT=32
# 单次工具返回的上限，防止一次返回把窗口撑爆。
# 与下面的上下文压缩是两回事：摘要折叠的是历史消息，管不到单条返回的大小
AGENT_TOOL_PAYLOAD_TOKENS=1200
# expand_section 的独立预算。完整章节比检索片段长得多，
# 用同一个上限会把「完整步骤」截成半截，等于没完成这个工具存在的目的
AGENT_EXPAND_PAYLOAD_TOKENS=2400
# 上下文压缩：消息数超过 TRIGGER 就把早期消息折叠成摘要，
# 保留最近 KEEP 条原文。KEEP 太小会让指代消解失准
AGENT_SUMMARY_TRIGGER=20
AGENT_SUMMARY_KEEP=8
# 服务端会话：打开后 /api/chat 带 session_id 即按该 id 持久化对话，
# 刷新页面乃至重启进程都不丢上下文。关闭时 history 由前端维护、服务端不存。
# 注意 session_id 是 bearer 凭据而非身份认证，拿到 id 的人就是会话的主人；
# 公网暴露时务必同时配置 APP_API_TOKEN
AGENT_SESSION_ENABLED=false

# 会话落盘位置（SQLite）。⚠️ 这是唯一会把对话原文写进磁盘的地方，
# 开启前请确认你能回答「存多久、谁能读、怎么删」。开关关闭时不会创建该文件。
# 容器部署务必指向挂载卷，否则容器一重建会话全没。
AGENT_SESSION_DB=data/sessions.db

# === 服务 ===
HOST=0.0.0.0
PORT=8000
# 允许跨域的来源，逗号分隔。前后端同源时无需放开；
# 本服务持有 API Key 且可删除文件，不要设为 *
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 设置后所有 /api/* 请求必须携带 X-API-Token 请求头；留空表示不鉴权
APP_API_TOKEN=

# === 日志与排障（改这几项必须重启才生效）===
# DEBUG 会把 httpx 每次请求、chromadb 的内部动作也打出来，量很大；
# 排查 agent 时更常用的是保持 INFO、单独打开下面的 AGENT_TRACE
LOG_LEVEL=INFO
# 日志文件路径，留空只输出到控制台。控制台一关就什么都没有了，
# 而 agent 的问题常常是事后才发现的那种
# LOG_FILE=logs/app.log
# 单文件大小上限（MB）与保留份数。日志只增不减就是一条磁盘泄漏
LOG_MAX_MB=20
LOG_BACKUPS=3
# Agent 全链路 trace：每次模型调用的完整 prompt、每个工具的入参与返回。
# 走标准 logging，所以设了 LOG_FILE 就会一起落盘。
# 默认关闭，因为它会把提问与文档原文完整写进日志——留痕本身就是暴露面
AGENT_TRACE=false

# === 可观测性 ===
# 结构化请求日志：一行一个 JSON（trace_id / 路径 / token / 成本 / 分阶段耗时），
# 可直接喂给 jq、pandas 或 Loki。
# 强烈建议单独给一个文件：人读日志带缩进和多行栈回溯，混在一起两者都变难用。
# REQUEST_LOG_FILE=logs/requests.jsonl

# Prometheus 指标（GET /metrics，复用 X-API-Token 鉴权）。
# 需要 prometheus-client（已在 requirements.txt 中）；缺它时 /metrics 返回 501，
# 而 trace_id、成本核算、结构化日志与在线反馈照常工作。
METRICS_ENABLED=true

# 模型单价，JSON：{"模型名": {"prompt": 每千token价, "completion": ...}}，
# "default" 兜底。留空表示一律按 0 计——自建服务确实不按 token 计费，
# 此时报 0 比报一个瞎猜的数字诚实。
# 按模型名而不是一个全局单价：llm_model 可以热改，而云端与自建模型的成本
# 差着好几个数量级。
# LLM_PRICING={"qwen-plus":{"prompt":0.0008,"completion":0.002}}
COST_CURRENCY=CNY

# 向端点索取 token 用量（stream_options.include_usage）。流式响应默认不返回
# usage，不显式索要就只能靠估算，而估算值不能用来对账。
# DashScope 与较新的 Ollama 都支持；个别 vLLM / llama.cpp 版本会对这个参数
# 返回 400。固定管道会自动探测并回退，agent 路径受 langchain 封装所限只能靠
# 这个开关——真撞上时报错信息里会直接提示你关掉它。
LLM_STREAM_USAGE=true

# === 在线反馈 ===
# 落盘每一次问答的现场 + 用户的 👍/👎。它补的是评测闭环里唯一缺的一环：
# 在它之前，回归题集的每道题都靠人手写，「线上答错了」和「回归集里多一条
# 用例」之间隔着一个人的记性。
#   导出：python scripts/badcase_export.py -o eval/questions.badcase.jsonl
#
# ⚠️ 会把提问、答案与文档原文写进磁盘，和 AGENT_TRACE 是同一类暴露面。
FEEDBACK_ENABLED=true
FEEDBACK_DB=data/feedback.db
# 记录条数上限，超出则淘汰最老的、且没有人评价过的记录。
# 「只增不减」是一条磁盘泄漏（和日志要滚动同理）；而被评价过的记录正是
# 这张表存在的理由，不参与淘汰。
FEEDBACK_MAX_ROWS=20000

# === 可选：加速模型下载 ===
# Hugging Face 访问令牌，可提高下载速率上限
# HF_TOKEN=
# 国内网络可走镜像
# HF_ENDPOINT=https://hf-mirror.com
