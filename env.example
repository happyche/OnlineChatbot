# === 对话模型配置 ===
# openai = 云端 API（需要 API Key，按量计费）
# local  = 自建的 OpenAI 兼容服务（Ollama / vLLM / LM Studio / llama.cpp），
#          可以在本机，也可以在内网服务器上
LLM_PROVIDER=openai

# --- LLM_PROVIDER=openai 时生效 ---
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# --- LLM_PROVIDER=local 时生效 ---
# 必须是 OpenAI 兼容地址，通常以 /v1 结尾。填服务器实际 IP 或主机名。
# 常见默认端口：Ollama 11434 ｜ vLLM 8000 ｜ LM Studio 1234 ｜ llama.cpp 8080
#
# Ollama 提示：默认只监听 127.0.0.1，从别的机器连不上。需要在服务器上设置
# OLLAMA_HOST=0.0.0.0:11434 后重启，并放行防火墙端口。
# 模型名必须带 tag（qwen2.5:7b 而非 qwen2.5），用 ollama list 查看。
LOCAL_LLM_BASE_URL=http://192.168.1.10:11434/v1
LOCAL_LLM_MODEL=qwen2.5:7b
# 多数自建服务不校验；vLLM 若启用了 --api-key 则填写
LOCAL_LLM_API_KEY=
# 本地模型首字延迟通常更长，必要时调大下方的 REQUEST_TIMEOUT

# === 嵌入配置 ===
# local  = 本地 ONNX 推理（默认）：离线、免费、文本不出本机
# openai = 远程接口：省本地资源，但文本会离开本机且按量计费
# hashing = 确定性哈希，仅供测试
EMBEDDING_PROVIDER=local

# --- provider=local 时生效 ---
# bge-small-zh-v1.5：约 90MB、512 维、中文检索质量足够，输出已 L2 归一化
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# 模型权重缓存目录，留空则用 ~/.cache/fastembed。
# 不要放系统临时目录，会被清理后触发重新下载。
EMBEDDING_CACHE_DIR=
# 部分模型要求查询与文档使用不同的指令前缀（如 e5 系列的 "query: " / "passage: "）。
# bge-*-v1.5 不需要，留空即可。
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=

# --- provider=openai 时生效 ---
EMBEDDING_MODEL=text-embedding-v3
# 嵌入接口的独立地址；留空则复用当前生效的对话端点。
# 注意：DashScope 的 coding 专用端点（coding.dashscope.aliyuncs.com）只提供
# chat，不提供 /embeddings。若 LLM_BASE_URL 指向该端点，这里必须填标准端点。
EMBEDDING_BASE_URL=
# 嵌入接口的独立 Key；留空则复用对话端点的 Key。
# 对话走内网自建（无需 Key）而嵌入走云端（需要 Key）时必须单独配置。
EMBEDDING_API_KEY=
# 单次嵌入请求的文本条数上限
EMBEDDING_BATCH_SIZE=10

# === RAG 配置 ===
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
TEMPERATURE=0.7
# 余弦相似度低于该值的检索结果被丢弃，避免无关内容污染上下文。
# 只作用于向量这一路：BM25 命中的片段不受此阈值限制。
MIN_SIMILARITY=0.2

# === 检索增强（两个开关可独立开闭，便于做消融对比）===
# 混合检索：向量检索之外并行跑 BM25，用 RRF 融合两路排名。
# 向量检索靠语义，对精确串（kubectl exec、错误码、配置项名）较弱，BM25 互补。
HYBRID_SEARCH_ENABLED=false
# BM25 分词器：jieba=词粒度｜bigram=字符二元组（不受词典覆盖率影响）
BM25_TOKENIZER=jieba
# RRF 平滑常数，越大则头部名次优势越小；60 为原论文取值
RRF_K=60

# 交叉编码器重排：对候选精排，精度更高但耗时明显增加
RERANK_ENABLED=false
# local=本地 ONNX 交叉编码器｜lexical=字面重叠度（仅冒烟用）
RERANK_PROVIDER=local
# bge-reranker-base 约 1GB、支持中文
# 预下载： python scripts/download_model.py --reranker
RERANK_MODEL=BAAI/bge-reranker-base
# 重排分数下限，留空表示不过滤。交叉编码器输出未归一化，需实测后再定。
MIN_RERANK_SCORE=

# 开启融合或重排时每路先取的候选数，融合/精排后再截到 TOP_K。
# 太小会让重排无从改进排序。
CANDIDATE_POOL_SIZE=20
# 送入模型的历史消息条数上限（2 条为一轮）
HISTORY_LIMIT=10
REQUEST_TIMEOUT=60
# 访问内网/本机地址时绕过 HTTP_PROXY。企业环境普遍配了代理，而客户端默认
# 读取该环境变量，会导致内网自建服务的请求被发去代理并返回 HTML 错误页。
BYPASS_PROXY_FOR_INTERNAL=true

# 送入 LLM 的历史消息条数上限（2 条 = 1 轮问答）
HISTORY_LIMIT=10

# === 多轮 Query Rewrite（检索前改写；生成仍用原问题 + 历史）===
# 默认开启；首问或无指代时不额外调 LLM
QUERY_REWRITE_ENABLED=true
# conditional=启发式触发 | always=有 history 就改写 | off=关闭
QUERY_REWRITE_MODE=conditional
# 改写 prompt 使用的历史条数（默认 6 条 ≈ 3 轮）
REWRITE_HISTORY_LIMIT=6
# 条件触发：问句不超过该字数时视为可能省略
REWRITE_TRIGGER_MAX_LEN=12
# 逗号分隔正则；留空用内置指代词表
# REWRITE_TRIGGER_PATTERNS=它,这个,刚才
# 留空复用对话模型；可指定更小模型降延迟
# REWRITE_MODEL=
REWRITE_TEMPERATURE=0

# === 服务 ===
HOST=0.0.0.0
PORT=8000
# 允许跨域的来源，逗号分隔。前后端同源时无需放开；
# 本服务持有 API Key 且可删除文件，不要设为 *
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# 设置后所有 /api/* 请求必须携带 X-API-Token 请求头；留空表示不鉴权
APP_API_TOKEN=

# === 可选：加速模型下载 ===
# Hugging Face 访问令牌，可提高下载速率上限
# HF_TOKEN=
# 国内网络可走镜像
# HF_ENDPOINT=https://hf-mirror.com
